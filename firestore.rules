rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validContent(data) {
      // contentJson est une chaîne opaque : le schéma interne est contrôlé par le client.
      return data.contentJson is string && data.contentJson.size() > 0 && data.contentJson.size() <= 800000;
    }
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }
    function validTrip(data) {
      return data.keys().hasAll(['contentJson', 'updatedAt', 'updatedByUid', 'updatedByName'])
        && data.keys().hasOnly(['contentJson', 'updatedAt', 'updatedByUid', 'updatedByName'])
        && validContent(data) && validName(data.updatedByName)
        && data.updatedByUid == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    function validHistory(data) {
      return data.keys().hasAll(['contentJson', 'changedAt', 'changedByUid', 'changedByName', 'changedSections'])
        && data.keys().hasOnly(['contentJson', 'changedAt', 'changedByUid', 'changedByName', 'changedSections'])
        && validContent(data) && validName(data.changedByName)
        && data.changedByUid == request.auth.uid
        && data.changedAt is timestamp && data.changedAt == request.time
        && data.changedSections is list && data.changedSections.size() <= 32
        && data.changedSections.hasOnly(['text', 'textAuthors', 'days', 'activities', 'budgets', 'faqs', 'checklist', 'shopping', 'ideas', 'assistanceContacts', 'dataVersion', 'activityVersion', 'faqVersion', 'checklistVersion', 'contactsVersion', 'ideasVersion', 'shoppingVersion', 'initialisation']);
    }

    match /trips/embrun-2027 {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && validTrip(request.resource.data);
      allow delete: if false;
    }
    match /trips/embrun-2027/history/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validHistory(request.resource.data);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
