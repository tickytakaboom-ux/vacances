rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/trips/embrun-2027/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/trips/embrun-2027/members/$(request.auth.uid)).data.active == true;
    }

    match /trips/embrun-2027 {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }
    match /trips/embrun-2027/history/{entryId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.changedByUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /trips/embrun-2027/members/{memberUid} {
      allow get: if request.auth != null && request.auth.uid == memberUid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
